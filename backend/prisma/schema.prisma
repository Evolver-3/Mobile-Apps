generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

model Todo {
  id        String   @id @default(cuid())
  title     String
  tag       String
  colors    String?
  darkColor String?
  completed Boolean  @default(false)
  dueDate   DateTime?
  createdAt DateTime @default(now())
}